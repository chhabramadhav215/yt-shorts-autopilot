# ==============================================================
# YOUTUBE SHORTS AUTOMATED PUBLISHER CONFIGURATION
# ==============================================================

# YouTube OAuth Configuration
YOUTUBE_CLIENT_SECRET_PATH=./client_secret.json
YOUTUBE_TOKEN_PATH=./token.json
# Upload privacy: 'unlisted' by default for safe pre-upload verification (or 'public', 'private')
UPLOAD_PRIVACY=unlisted
YOUTUBE_PRIVACY_STATUS=unlisted

# Telegram Bot Integration (Optional but recommended)
# 1. Create a bot via @BotFather on Telegram and paste the token below
TELEGRAM_BOT_TOKEN=
# 2. To restrict bot commands to only your account, enter your numeric Telegram User ID (get via @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# 4 Daily Publishing Schedules (Standard 5-field cron format)
# Slot 1 (Entertainment): 09:00 AM IST
SLOT1_CRON=0 9 * * *
# Slot 2 (Devotional): 02:00 PM IST
SLOT2_CRON=0 14 * * *
# Slot 4 (Epic Scriptures & Wisdom Clips): 05:00 PM IST
SLOT4_CRON=0 17 * * *
# Slot 3 (Viral News): 07:30 PM IST
SLOT3_CRON=30 19 * * *
# Timezone
TIMEZONE=Asia/Kolkata

# Neural Voices (Free Microsoft Edge TTS - Hindi Voiceover)
# Slot 1: Energetic Hindi voice
SLOT1_VOICE=hi-IN-MadhurNeural
# Slot 2: Peaceful Hindi voice (or hi-IN-SwaraNeural)
SLOT2_VOICE=hi-IN-MadhurNeural
# Slot 4: Epic Philosophical Hindi voice
SLOT4_VOICE=hi-IN-MadhurNeural
# Slot 3: Clear News Anchor Hindi voice
SLOT3_VOICE=hi-IN-MadhurNeural

# Optional Integrations
# Pexels API Key for downloading vertical stock video clips (free at https://www.pexels.com/api/)
PEXELS_API_KEY=
# Google Gemini API Key for customized AI script generation (optional)
GEMINI_API_KEY=

# Meta Graph API (Instagram Reels & Facebook Reels Automated Publishing)
# Long-lived User/System User Access Token with instagram_basic, instagram_content_publish, pages_manage_posts
META_ACCESS_TOKEN=
# Instagram Business or Creator Account ID (e.g. 178414...)
INSTAGRAM_ACCOUNT_ID=
# Facebook Page ID for cross-posting to Facebook Reels (optional)
FACEBOOK_PAGE_ID=
ENABLE_FACEBOOK_REELS=true
